# 本文件仅为配置说明。程序读取进程环境变量，不自动加载此文件。
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 正式运行必须设置随机密钥，不要把真实值提交到 Git。
DJANGO_SECRET_KEY=
DJANGO_DB_PATH=data/db.sqlite3
APP_VERSION=v1
LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT=20
LLM_MAX_TOKENS=800
